{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cygnus Forge: web server",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "cygnusforge.web.app:app_from_env",
                "--factory",
                "--reload"
            ],
            "python": "${workspaceFolder}/.venv/bin/python",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "jinja": true,
            "justMyCode": false
        }
    ]
}