[
  {
    "type": "python_module",
    "id": "dungeon",
    "module": "cygnusforge.services.dungeon"
  },
  {
    "type": "rule_data",
    "id": "dungeon",
    "python_module": "dungeon",
    "configure": "configure_dungeon",
    "event_table": "dungeon_events",
    "reaction_table": "dungeon_reaction",
    "triggers": ["new_area", "loud", "hasty", "lingering"],
    "notes": {
      "Encounter": "Roll the location's encounter table with roll_tables, then roll_reaction if needed."
    }
  },
  {
    "type": "dice_table",
    "id": "dungeon_events",
    "name": "Dungeon Events",
    "dice": "1d6",
    "rows": [
      {
        "roll": "1",
        "result": "Encounter",
        "text": "Roll on an encounter table. Possibly hostile. (See Reactions.)"
      },
      {
        "roll": "2",
        "result": "Sign",
        "text": "A clue, spoor, track, abandoned lair, scent, victim, etc is discovered."
      },
      {
        "roll": "3",
        "result": "Environment",
        "text": "Surroundings shift or escalate. Water rises, ceilings collapse, a ritual nears completion, etc."
      },
      {
        "roll": "4",
        "result": "Loss",
        "text": "Torches are blown out, an ongoing spell fizzles, etc. The party must resolve the effect before moving on."
      },
      {
        "roll": "5",
        "result": "Exhaustion",
        "text": "The party must rest (triggering another roll on this table), add a Fatigue, or consume a ration."
      },
      {
        "roll": "6",
        "result": "Quiet",
        "text": "The party is left alone (and safe) for the time being."
      }
    ]
  },
  {
    "type": "dice_table",
    "id": "dungeon_reaction",
    "name": "Reaction",
    "dice": "2d6",
    "rows": [
      {
        "roll": "2",
        "result": "Hostile"
      },
      {
        "roll": "3-5",
        "result": "Wary"
      },
      {
        "roll": "6-8",
        "result": "Curious"
      },
      {
        "roll": "9-11",
        "result": "Kind"
      },
      {
        "roll": "12",
        "result": "Helpful"
      }
    ]
  }
]
