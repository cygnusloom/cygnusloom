# Copy to .env and replace every change-me value.
# Generate secrets with: openssl rand -hex 32

# Public hostnames. Caddy obtains TLS for these names.
CYGNUSFORGE_DOMAIN=forge.example.com
AUTHENTIK_DOMAIN=idp.example.com
ACME_EMAIL=you@example.com

# Application secrets and database
CYGNUSFORGE_SECRET_KEY=change-me-application-secret
POSTGRES_PASSWORD=change-me-postgres-password

# Authentik secrets and database
AUTHENTIK_SECRET_KEY=change-me-authentik-secret
AUTHENTIK_POSTGRES_PASSWORD=change-me-authentik-postgres-password
# Pin this in production; the default is updated by the project.
# AUTHENTIK_IMAGE=ghcr.io/goauthentik/server:2026.5.3

# Initial Authentik account (username: akadmin). Used only on the first start.
# Change the password in Authentik after signing in.
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me-authentik-admin-password

# OIDC client shared by Cygnusforge and Authentik
CYGNUSFORGE_OIDC_CLIENT_ID=cygnusforge
CYGNUSFORGE_OIDC_CLIENT_SECRET=change-me-oidc-client-secret
CYGNUSFORGE_OIDC_NAME=Cygnus Forge SSO

# Group in Authentik that grants the Cygnusforge administrator role
CYGNUSFORGE_ADMIN_GROUP=cygnusforge-admins

# Cygnus Forge does not provide an LLM. Add models in Admin -> Models after signing in.
# These variables are only a development seed for the first start; the admin panel is
# authoritative after that. Use fake/scripted for a local test without a real model.
# CYGNUSFORGE_LLM_PROVIDERS=fake/scripted
# CYGNUSFORGE_LLM_DEFAULT_MODEL=fake/scripted
# CYGNUSFORGE_LLM_OLLAMA_BASE_URL=http://localhost:11434/v1
# CYGNUSFORGE_LLM_OPENAI_BASE_URL=https://api.openai.com/v1
# CYGNUSFORGE_LLM_OPENAI_API_KEY=

# Optional: where users manage their profile, password, and MFA at the IdP
# CYGNUSFORGE_OIDC_ACCOUNT_URL=https://idp.example.com/if/user/

