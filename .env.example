# Copy to .env and replace every change-me value.
# Generate secrets with: openssl rand -hex 32

# Public hostnames. Your reverse proxy (nginx) terminates TLS for these names.
CYGNUSLOOM_DOMAIN=cygnusloom.example.com
AUTHENTIK_DOMAIN=idp.example.com
ACME_EMAIL=you@example.com

# Host loopback ports for the reverse proxy. The containers still listen on 8000/9000.
CYGNUSLOOM_APP_PORT=21872
AUTHENTIK_PORT=21873

# Application secrets and database
CYGNUSLOOM_SECRET_KEY=change-me-application-secret
POSTGRES_PASSWORD=change-me-postgres-password

# Authentik secrets and database
AUTHENTIK_SECRET_KEY=change-me-authentik-secret
AUTHENTIK_POSTGRES_PASSWORD=change-me-authentik-postgres-password
# Pin this in production; the default is updated by the project.
# AUTHENTIK_IMAGE=ghcr.io/goauthentik/server:2026.5.3

# Initial Authentik account (username: akadmin). Used only on the first start.
# Change the password in Authentik after signing in.
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me-authentik-admin-password

# OIDC client shared by Cygnus Loom and Authentik
CYGNUSLOOM_OIDC_CLIENT_ID=cygnusloom
CYGNUSLOOM_OIDC_CLIENT_SECRET=change-me-oidc-client-secret
CYGNUSLOOM_OIDC_NAME="Cygnus Loom SSO"

# Group in Authentik that grants the Cygnus Loom administrator role
CYGNUSLOOM_ADMIN_GROUP=cygnusloom-admins

# Cygnus Loom does not provide an LLM. Add models in Admin -> Models after signing in.
# These variables are only a development seed for the first start; the admin panel is
# authoritative after that. Use fake/scripted for a local test without a real model.
# CYGNUSLOOM_LLM_PROVIDERS=fake/scripted
# CYGNUSLOOM_LLM_DEFAULT_MODEL=fake/scripted
# CYGNUSLOOM_LLM_OLLAMA_BASE_URL=http://localhost:11434/v1
# CYGNUSLOOM_LLM_OPENAI_BASE_URL=https://api.openai.com/v1
# CYGNUSLOOM_LLM_OPENAI_API_KEY=

# Prompt detail: brief (default), compact, summary, full for tools; brief, index, full for rules.
# CYGNUSLOOM_TOOL_SCHEMA_MODE=brief
# CYGNUSLOOM_RULE_INFO_MODE=brief

# Optional: where users manage their profile, password, and MFA at the IdP. Authentik and
# Keycloak are detected from CYGNUSLOOM_OIDC_ISSUER; set this for other providers.
# CYGNUSLOOM_OIDC_ACCOUNT_URL=https://idp.example.com/if/user/

